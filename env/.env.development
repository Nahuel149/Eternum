# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/eternum
# For MongoDB Atlas use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/eternum?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# File Upload Configuration
MAX_FILE_SIZE=26214400  # 25MB in bytes
UPLOAD_PATH=./uploads

# AWS S3 Configuration (Optional - for production file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=eternum-assets

# OpenAI Configuration (for AI features)
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORGANIZATION=your-org-id

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Voice Processing (Optional)
DEEPGRAM_API_KEY=your-deepgram-api-key
ASSEMBLY_AI_KEY=your-assembly-ai-key

# Security
BCRYPT_ROUNDS=10
SESSION_SECRET=your-session-secret-key

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/eternum.log

# Redis Configuration (Optional - for caching/sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Webhooks (Optional)
WEBHOOK_SECRET=your-webhook-secret
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...