# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/eternum

# MongoDB Atlas (Cloud) - Replace with your connection string
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/eternum?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=30d

# Password Hashing
BCRYPT_ROUNDS=10

# File Upload Configuration
MAX_FILE_SIZE=104857600
# 104857600 = 100MB in bytes
# 26214400 = 25MB in bytes
# 10485760 = 10MB in bytes

# AWS S3 Configuration (Optional - for cloud file storage)
# If not provided, files will be stored locally
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=eternum-assets

# Email Configuration (for notifications and password reset)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@eternum.world

# SMTP Configuration (alternative to EMAIL_SERVICE)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password

# OpenAI API Configuration (for AI features)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ORG_ID=org-your-organization-id

# Voice Processing Services (Optional)
# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# CORS Configuration
CORS_ORIGIN=http://localhost:8080,http://localhost:3001,https://eternum.world
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# 900000 = 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-for-payments-etc

# Payment Processing (if implementing premium features)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# PayPal Configuration
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox
# Set to 'live' for production

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/eternum-backend.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Security Configuration
SESSION_SECRET=your-session-secret-key
CSRF_SECRET=your-csrf-secret-key

# Analytics and Monitoring
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX-X
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Social Media Integration
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret

# Development Configuration
DEBUG=eternum:*
ENABLE_SWAGGER=true
ENABLE_PLAYGROUND=true

# Production Configuration
# Set these in production environment
ENABLE_HTTPS=false
SSL_CERT_PATH=path/to/ssl/cert.pem
SSL_KEY_PATH=path/to/ssl/private-key.pem

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
# Cron format: daily at 2 AM
BACKUP_S3_BUCKET=eternum-backups

# Feature Flags
ENABLE_VOICE_CLONING=true
ENABLE_AI_GENERATION=true
ENABLE_PREMIUM_FEATURES=true
ENABLE_SOCIAL_FEATURES=true
ENABLE_PAYMENTS=false

# Admin Configuration
ADMIN_EMAIL=admin@eternum.world
ADMIN_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-this-password

# API Versioning
API_VERSION=v1
API_PREFIX=/api

# Performance Configuration
CLUSTER_MODE=false
WORKER_PROCESSES=auto
KEEP_ALIVE_TIMEOUT=5000

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Eternum is currently under maintenance. Please try again later.

# Notification Configuration
PUSH_NOTIFICATION_KEY=your-push-notification-key
WEBHOOK_NOTIFICATION_URL=https://your-app.com/webhooks/notifications

# Avatar Processing
AVATURN_API_KEY=your-avaturn-api-key
READY_PLAYER_ME_APP_ID=your-ready-player-me-app-id

# 3D Model Processing
ENABLE_3D_PROCESSING=true
MAX_3D_MODEL_SIZE=52428800
# 52428800 = 50MB in bytes

# Blockchain/Web3 Configuration (for future NFT features)
WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/your-project-id
PRIVATE_KEY=your-ethereum-private-key
CONTRACT_ADDRESS=your-smart-contract-address

# Content Moderation
ENABLE_CONTENT_MODERATION=true
MODERATION_API_KEY=your-moderation-api-key

# Geolocation Services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Time Zone
TZ=UTC